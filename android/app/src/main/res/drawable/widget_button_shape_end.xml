<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_surface_pressed" />
            <corners android:bottomLeftRadius="6dp" android:bottomRightRadius="16dp" android:topLeftRadius="6dp" android:topRightRadius="16dp" />
            <padding android:bottom="8dp" android:left="8dp" android:right="8dp" android:top="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_surface_highest" />
            <corners android:bottomLeftRadius="6dp" android:bottomRightRadius="16dp" android:topLeftRadius="6dp" android:topRightRadius="16dp" />
            <padding android:bottom="8dp" android:left="8dp" android:right="8dp" android:top="8dp" />
        </shape>
    </item>
</selector>
